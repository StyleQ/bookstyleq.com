# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Required. Your Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Optional but recommended. The verified sender the brochure email comes from.
# Until you verify your domain in Resend, you can only send from
# "onboarding@resend.dev" and only to your own account email (good for testing).
# Once bookstyleq.com is verified, set something like:
# NEWSLETTER_FROM="StyleQ <hello@bookstyleq.com>"
NEWSLETTER_FROM=

# Optional. Where replies to the brochure email are delivered.
# Defaults to chantel@bookstyleq.com if unset.
NEWSLETTER_REPLY_TO=

# Optional. Base URL used to build the brochure download link in the email.
# Defaults to https://bookstyleq.com if unset.
NEXT_PUBLIC_SITE_URL=https://bookstyleq.com
