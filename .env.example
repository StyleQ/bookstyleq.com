# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Required. Your Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Optional but recommended. The verified sender the brochure email comes from.
# Until you verify your domain in Resend, you can only send from
# "onboarding@resend.dev" and only to your own account email (good for testing).
# Once bookstyleq.com is verified, set something like:
# NEWSLETTER_FROM="StyleQ <hello@bookstyleq.com>"
NEWSLETTER_FROM=

# Optional. Where replies to the brochure email are delivered.
# Defaults to chantel@bookstyleq.com if unset.
NEWSLETTER_REPLY_TO=

# Optional. Base URL used to build the brochure download link in the email.
# Defaults to https://bookstyleq.com if unset.
NEXT_PUBLIC_SITE_URL=https://bookstyleq.com

# Cloudflare Turnstile (bot protection on the Book a Call and brochure forms).
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# (any free Cloudflare account works; the site does not need to be on
# Cloudflare DNS). Use "Managed" mode. Set BOTH keys together: the site key
# renders the widget, the secret key makes the server enforce verification.
# With neither set, the form still works (honeypot + rate limiting only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog product analytics. Both are safe to expose in the browser (the
# project token is publishable). Get the token from PostHog > Project Settings.
# Without these, analytics is silently a no-op (site still works fine).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
